import "buzz:std";

test "foreach on list" {
    final list = [ 1, 2, 3 ];

    var sum = 0;
    foreach (item in list) {
        sum = sum + item;
    }

    std\assert(sum == 6, message: "foreach on list");
}

test "foreach on map" {
    final map = {
        "one": 1,
        "two": 2,
        "three": 3,
    };

    var sum = 0;
    foreach (value in map) {
        sum = sum + value;
    }

    std\assert(sum == 6, message: "foreach on map");
}

test "foreach on map with null key" {
    final map = { <str?: int>, null: 1, "two": 2 };

    var sum = 0;
    var saw_null_key = false;
    foreach (key, value in map) {
        if (key == null) {
            saw_null_key = true;
        }

        sum = sum + value;
    }

    std\assert(saw_null_key, message: "foreach should not stop on a null map key");
    std\assert(sum == 3, message: "foreach should visit every map entry");
}

enum Hey {
    one,
    two,
    three,
}

object ForeachCounter {
    seen: {int: bool},

    fun count() > int {
        var total = 0;
        foreach (key, value in this.seen) {
            _ = key;
            _ = value;
            total += 1;
        }

        return total;
    }
}

test "foreach on enum" {
    var sum = 0;
    foreach (case in Hey) {
        sum = sum + case.value;
    }

    std\assert(sum == 3, message: "foreach on enum");
}

test "foreach on str" {
    var hello = "";
    foreach (char in "hello world") {
        hello = "{hello}{char}";
    }

    std\assert(hello == "hello world", message: "foreach on str");
}

test "Omit key in foreach" {
    var sum = 0;
    foreach (n in [ 1, 2, 3 ]) {
        sum = sum + n;
    }
    std\assert(sum == 6, message: "Could omit list key");

    var hello = "";
    foreach (char in "hello") {
        hello = "{hello}{char}";
    }
    std\assert(hello == "hello", message: "Could omit string key");

    sum = 0;
    foreach (n in { "hello": 1, "world": 2 }) {
        sum = sum + n;
    }
    std\assert(sum == 3, message: "Could omit map key");
}

test "foreach on map in hotspot loop" {
    final map = {
        "one": 1,
        "two": 2,
        "three": 3,
    };

    var sum = 0;
    foreach (_ in 0..300) {
        foreach (key, value in map) {
            if (key == "one") {
                std\assert(
                    value == 1,
                    message: "foreach hotspot should keep matching map entries"
                );
            }

            sum = sum + value;
        }
    }

    std\assert(
        sum == 1800,
        message: "foreach hotspot should iterate every map entry"
    );
}

test "foreach on late-resolved map field" {
    final counter = ForeachCounter{
        seen = {
            1: true,
            2: false,
            3: true,
        },
    };

    std\assert(
        counter.count() == 3,
        message: "foreach should support map fields resolved after parsing"
    );
}
